$Common = "Common.ui";

Group {
  LayoutMode: Center;

  Group #RootPanel {
    Anchor: (Width: 700, Height: 500);
    LayoutMode: Top;

    Label #TitleLabel {
      Style: (FontSize: 28, Alignment: Center);
      Anchor: (Top: 15, Width: 650, Height: 40);
      Text: "Upgradeable Hoe";
    }

    Label #CurrencyLabel {
      Style: (FontSize: 22);
      Anchor: (Top: 25, Width: 650, Height: 40);
      Text: "Tokens: 0";
    }

    Label #TokenFinderLabel {
      Style: (FontSize: 24);
      Anchor: (Top: 20, Width: 650, Height: 35);
      Text: "Token Finder Lvl 0/10";
    }

    Label #TokenFinderCostLabel {
      Style: (FontSize: 18);
      Anchor: (Top: 8, Width: 650, Height: 30);
      Text: "Upgrade cost: 10";
    }

    Button #UpgradeTokenFinderButton {
      Anchor: (Top: 20, Width: 300, Height: 52);
      Text: "Upgrade Token Finder";
    }
  }
}
