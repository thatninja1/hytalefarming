Group #Root {
  LayoutMode: Center;

  Group #UpgradePanel {
    Anchor: (Width: 640, Height: 380);
    LayoutMode: Top;

    Label #TitleLabel {
      Anchor: (Top: 16, Width: 600, Height: 42);
      Text: "Thorium Hoe Upgrades";
      Style: (FontSize: 28, Alignment: Center);
    }

    Label #BalanceLabel {
      Anchor: (Top: 20, Width: 600, Height: 36);
      Text: "Tokens: 0";
      Style: (FontSize: 22, Alignment: Center);
    }

    Button #TokenFinderButton {
      Anchor: (Top: 28, Width: 360, Height: 52);
      Text: "Token Finder (Upgrade)";
    }
  }
}
