Group #Root {
  LayoutMode: Center;

  Group #UpgradePanel {
    Anchor: (Width: 640, Height: 420);
    LayoutMode: Top;

    Label #TitleLabel {
      Anchor: (Top: 16, Width: 600, Height: 42);
      Text: "Thorium Hoe Upgrades";
      Style: (FontSize: 28, Alignment: Center);
    }

    Label #BalanceLabel {
      Anchor: (Top: 20, Width: 600, Height: 36);
      Text: "Tokens: 0";
      Style: (FontSize: 22, Alignment: Center);
    }

    Button #TokenFinderButton {
      Anchor: (Top: 28, Width: 360, Height: 52);

      Label #TokenFinderButtonLabel {
        Anchor: (Width: 340, Height: 36);
        Text: "Token Finder (Upgrade)";
        Style: (FontSize: 20, Alignment: Center);
      }
    }

    Button #CloseButton {
      Anchor: (Top: 16, Width: 180, Height: 44);

      Label #CloseButtonLabel {
        Anchor: (Width: 160, Height: 32);
        Text: "Close";
        Style: (FontSize: 18, Alignment: Center);
      }
    }
  }
}
