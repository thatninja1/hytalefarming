Group #Root {
  LayoutMode: Top;

  Label #TitleLabel {
    Anchor: (Top: 24, Left: 30, Width: 1200, Height: 52);
    Text: "Ninja Farming";
    Style: (FontSize: 42, Alignment: Center);
  }

  Label #SubtitleLabel {
    Anchor: (Top: 4, Left: 30, Width: 1200, Height: 30);
    Text: "Upgrade your Thorium Hoe";
    Style: (FontSize: 20, Alignment: Center);
  }

  Label #TokenBalanceLabel {
    Anchor: (Top: 8, Left: 30, Width: 1200, Height: 30);
    Text: "Tokens: 0";
    Style: (FontSize: 22, Alignment: Center);
  }

  Group #UpgradeRow {
    Anchor: (Top: 18, Left: 30, Width: 1200, Height: 240);
    LayoutMode: Left;

    Group #TokenFinderTile {
      Anchor: (Width: 220, Height: 220);
      LayoutMode: Top;

      Label #TokenFinderTitle {
        Anchor: (Top: 8, Width: 210, Height: 28);
        Text: "Token Finder";
        Style: (FontSize: 20, Alignment: Center);
      }

      Label #TokenFinderLevelLabel {
        Anchor: (Top: 4, Width: 210, Height: 24);
        Text: "Level: 0 / 10";
        Style: (FontSize: 16, Alignment: Center);
      }

      Label #TokenFinderCostLabel {
        Anchor: (Top: 2, Width: 210, Height: 24);
        Text: "Cost: 10 Tokens";
        Style: (FontSize: 16, Alignment: Center);
      }

      Button #TokenFinderUpgradeButton {
        Anchor: (Top: 8, Width: 180, Height: 40);
        Label #TokenFinderUpgradeButtonLabel {
          Anchor: (Width: 160, Height: 28);
          Text: "Upgrade";
          Style: (FontSize: 16, Alignment: Center);
        }
      }
    }

    Group #Tile2 {
      Anchor: (Left: 20, Width: 220, Height: 220);
      LayoutMode: Top;
      Label #Tile2Title { Anchor: (Top: 8, Width: 210, Height: 28); Text: "Coming Soon"; Style: (FontSize: 20, Alignment: Center); }
      Label #Tile2Level { Anchor: (Top: 4, Width: 210, Height: 24); Text: "Level: --"; Style: (FontSize: 16, Alignment: Center); }
      Label #Tile2Cost { Anchor: (Top: 2, Width: 210, Height: 24); Text: "Cost: N/A"; Style: (FontSize: 16, Alignment: Center); }
      Button #Tile2Button { Anchor: (Top: 8, Width: 180, Height: 40); Label #Tile2ButtonLabel { Anchor: (Width: 160, Height: 28); Text: "Upgrade"; Style: (FontSize: 16, Alignment: Center); } }
    }

    Group #Tile3 {
      Anchor: (Left: 20, Width: 220, Height: 220);
      LayoutMode: Top;
      Label #Tile3Title { Anchor: (Top: 8, Width: 210, Height: 28); Text: "Coming Soon"; Style: (FontSize: 20, Alignment: Center); }
      Label #Tile3Level { Anchor: (Top: 4, Width: 210, Height: 24); Text: "Level: --"; Style: (FontSize: 16, Alignment: Center); }
      Label #Tile3Cost { Anchor: (Top: 2, Width: 210, Height: 24); Text: "Cost: N/A"; Style: (FontSize: 16, Alignment: Center); }
      Button #Tile3Button { Anchor: (Top: 8, Width: 180, Height: 40); Label #Tile3ButtonLabel { Anchor: (Width: 160, Height: 28); Text: "Upgrade"; Style: (FontSize: 16, Alignment: Center); } }
    }

    Group #Tile4 {
      Anchor: (Left: 20, Width: 220, Height: 220);
      LayoutMode: Top;
      Label #Tile4Title { Anchor: (Top: 8, Width: 210, Height: 28); Text: "Coming Soon"; Style: (FontSize: 20, Alignment: Center); }
      Label #Tile4Level { Anchor: (Top: 4, Width: 210, Height: 24); Text: "Level: --"; Style: (FontSize: 16, Alignment: Center); }
      Label #Tile4Cost { Anchor: (Top: 2, Width: 210, Height: 24); Text: "Cost: N/A"; Style: (FontSize: 16, Alignment: Center); }
      Button #Tile4Button { Anchor: (Top: 8, Width: 180, Height: 40); Label #Tile4ButtonLabel { Anchor: (Width: 160, Height: 28); Text: "Upgrade"; Style: (FontSize: 16, Alignment: Center); } }
    }

    Group #Tile5 {
      Anchor: (Left: 20, Width: 220, Height: 220);
      LayoutMode: Top;
      Label #Tile5Title { Anchor: (Top: 8, Width: 210, Height: 28); Text: "Coming Soon"; Style: (FontSize: 20, Alignment: Center); }
      Label #Tile5Level { Anchor: (Top: 4, Width: 210, Height: 24); Text: "Level: --"; Style: (FontSize: 16, Alignment: Center); }
      Label #Tile5Cost { Anchor: (Top: 2, Width: 210, Height: 24); Text: "Cost: N/A"; Style: (FontSize: 16, Alignment: Center); }
      Button #Tile5Button { Anchor: (Top: 8, Width: 180, Height: 40); Label #Tile5ButtonLabel { Anchor: (Width: 160, Height: 28); Text: "Upgrade"; Style: (FontSize: 16, Alignment: Center); } }
    }
  }

  Button #CloseButton {
    Anchor: (Top: 20, Left: 30, Width: 180, Height: 40);
    Label #CloseButtonLabel {
      Anchor: (Width: 160, Height: 28);
      Text: "Close";
      Style: (FontSize: 16, Alignment: Center);
    }
  }
}
